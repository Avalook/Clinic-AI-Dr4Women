# Dashboard env — copy thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local).

# --- Supabase (PUBLIC anon-tier — an toàn để lộ ở bundle trình duyệt) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Server-only (KHÔNG bao giờ gửi xuống trình duyệt) ---
# Service-role key: dùng cho các route handler ghi DB (vd /api/clinical-record).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Email của TÀI KHOẢN CHUNG mà cổng mật khẩu phòng khám đăng nhập vào.
CLINIC_SHARED_EMAIL=clinic@dr4women.vn

# --- Cầu nối tới FastAPI (tính năng "Tóm tắt trước khám") ---
# URL gốc của backend FastAPI. Mặc định http://localhost:8000 nếu để trống
# (dev không cần set). Lời gọi đi từ SERVER Next.js → KHÔNG dùng tiền tố
# NEXT_PUBLIC (không cần lộ ra trình duyệt), và né được CORS.
CLINIC_API_URL=http://localhost:8000
# Khóa API của FastAPI (khớp BACKEND_API_KEY của backend). Để trống khi dev
# (backend tự cho qua). Production PHẢI set cho khớp 2 bên.
BACKEND_API_KEY=
