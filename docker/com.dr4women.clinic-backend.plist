<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent giữ backend ClinicAI sống trên Mac mini M4.
  ĐÂY LÀ TEMPLATE — thay __REPO__ và __HOME__ trước khi cài (xem docs/deploy-mac-mini.md §E).
  Chạy clinic-backend-boot.sh lúc đăng nhập (RunAtLoad) + lặp mỗi 300s (self-heal).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dr4women.clinic-backend</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/clinic-backend-boot.sh</string>
    <string>__REPO__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/clinic-backend-boot.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/clinic-backend-boot.err.log</string>
</dict>
</plist>
